{
  "name": "OrionTV",
  "private": true,
  "main": "expo-router/entry",
  "version": "1.7.0",
  "license": "MIT",
  "scripts": {
    "start": "EXPO_TV=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "EXPO_TV=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 expo run:android",
    "ios": "EXPO_TV=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 expo run:ios",
    "prebuild": "EXPO_TV=1 EXPO_USE_METRO_WORKSPACE_ROOT=1 expo prebuild --clean && yarn copy-config",
    "copy-config": "cp xml/AndroidManifest.xml android/app/src/main/AndroidManifest.xml",
    "build": "NODE_ENV=production EXPO_TV=1 yarn prebuild && cd android && ./gradlew assembleRelease",
    "build-debug": "cd android && ./gradlew assembleDebug",
    "check-version": "node scripts/sync-version.js check",
    "test": "jest --watchAll",
    "test-ci": "jest --ci --coverage --no-cache",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .expo node_modules/.cache && yarn cache clean && cd android && ./gradlew clean",
    "clean-modules": "rm -rf node_modules && yarn install"
  },
  "jest": {
    "preset": "jest-expo",
    "coverageThreshold": {
      "global": {
        "branches": 35,
        "functions": 45,
        "lines": 45,
        "statements": 45
      },
      "services/api.ts": {
        "branches": 65,
        "functions": 60,
        "lines": 75,
        "statements": 75
      },
      "services/updateService.ts": {
        "branches": 5,
        "functions": 15,
        "lines": 25,
        "statements": 30
      },
      "services/storage.ts": {
        "branches": 1,
        "functions": 3,
        "lines": 7,
        "statements": 7
      }
    }
  },
  "resolutions": {
    "react-native": "npm:react-native-tvos@~0.88.1-0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/native": "^7.5.1",
    "expo": "~58.0.24",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.18",
    "expo-intent-launcher": "~58.0.3",
    "expo-keep-awake": "~58.0.4",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "npm:react-native-tvos@~0.88.1-0",
    "react-native-gesture-handler": "~3.5.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.1",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-toast-message": "^2.5.2",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "~0.13.1",
    "zustand": "^5.1.0",
    "expo-secure-store": "~58.0.3",
    "expo-file-system": "~58.0.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@react-native-tvos/config-tv": "^0.1.7",
    "@react-native/jest-preset": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.1",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
